[Unit]
Description=Litestream replication for NLM Controller DB
Documentation=https://litestream.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nlm
Group=nlm
EnvironmentFile=/etc/nlm/litestream.env
ExecStart=/usr/local/bin/litestream replicate -config /etc/litestream/litestream.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

ReadWritePaths=/var/lib/nlm

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
