[Unit]
Description=NetLatencyMonitor Controller
Documentation=https://github.com/jscobbie73/netlatencymonitor
After=network-online.target nlm-litestream.service
Wants=network-online.target

[Service]
Type=simple
User=nlm
Group=nlm
EnvironmentFile=/etc/nlm/controller.env
ExecStart=/usr/local/bin/nlm-controller
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

ReadWritePaths=/var/lib/nlm

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
